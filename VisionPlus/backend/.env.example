# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no setup needed):
DATABASE_URL=sqlite:///./visionplus.db

# PostgreSQL (recommended for production, required on Render):
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/visionplus
# On Render, set this to the "Internal Database URL" from your Render Postgres
# instance (render.yaml wires this automatically if you deploy via Blueprint).
# Render/Heroku sometimes hand out "postgres://" (old scheme) — the app
# normalizes this to "postgresql://" automatically, so either form works.

# ── JWT Authentication ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── Development Mode ──────────────────────────────────────────────────────────
# true  -> ALL auth is bypassed; every request is treated as a demo admin.
#          Login page is skipped and the dashboard opens immediately.
# false -> normal JWT login is enforced (production default).
# Auth code is never deleted — this is a pure runtime switch.
DEV_MODE=false
DEV_ADMIN_EMAIL=demo.admin@visionplus.local
DEV_ADMIN_NAME=Demo Administrator

# ── Grok AI (optional) ────────────────────────────────────────────────────────
# Leave blank to use the built-in rule-based chatbot (no API key needed).
# Set to your xAI API key (starts with "xai-") to enable Grok responses.
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1

# ── YOLO Model path (optional) ────────────────────────────────────────────────
# Leave blank to auto-resolve to ai_models/yolo11n.pt in the project root.
MODEL_PATH=

# ── Frontend CORS ─────────────────────────────────────────────────────────────
# Local dev default shown below. In production (e.g. Render), set this to
# your real deployed frontend origin(s) — for example your Vercel URL:
#   CORS_ALLOWED_ORIGINS=https://visionplus.vercel.app
# Never leave this as "*" in production; never commit a real production
# value here — set it in your host's dashboard/environment instead.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Analysis performance ──────────────────────────────────────────────────────
# Save a detection DB row every N frames (reduces DB size dramatically)
DETECTION_SAMPLE_EVERY=5
