# Base URL of the FastAPI backend.
# Local dev (default): your local backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (Vercel): set this as a Vercel Project Environment Variable to
# your deployed Render backend URL, e.g.:
#   VITE_API_BASE_URL=https://visionplus-backend.onrender.com
# Vite bakes VITE_* variables in at BUILD time, not runtime — so this must
# be set in Vercel's dashboard before/when the build runs, not just in a
# local .env file (which never reaches Vercel's build).

# Development Mode — must match the backend's DEV_MODE setting.
# true  -> skips the login page, auto-signs in as the Demo Administrator.
# false -> normal login flow (production default).
VITE_DEV_MODE=false
